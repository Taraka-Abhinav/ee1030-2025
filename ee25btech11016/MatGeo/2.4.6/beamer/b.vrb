\frametitle{Python Code - Final Plotting Details}
    \lstset{language=Python}
    \begin{lstlisting}
# Plotting settings
ax.set_xlabel('X Axis'); ax.set_ylabel('Y Axis')
ax.set_zlabel('Z Axis')
ax.set_title('3D Plot of Vectors')
ax.legend(); ax.grid(True)
ax.view_init(elev=20, azim=25) # Set view angle
plt.savefig("figs/Figure_1.png")
plt.show()
    \end{lstlisting}
